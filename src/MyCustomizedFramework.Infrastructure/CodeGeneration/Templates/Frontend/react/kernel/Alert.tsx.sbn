interface AlertProps {
  message: string;
  onDismiss?: () => void;
}

export function Alert({ message, onDismiss }: AlertProps) {
  return (
    <div role="alert" className="flex items-start justify-between rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <span>{message}</span>
      {onDismiss ? (
        <button type="button" onClick={onDismiss} className="ml-4 font-medium underline">
          Dismiss
        </button>
      ) : null}
    </div>
  );
}
