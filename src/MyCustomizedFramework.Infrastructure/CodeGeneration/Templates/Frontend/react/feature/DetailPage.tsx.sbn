import { useNavigate, useParams } from 'react-router-dom';
import { {{ entity_name }}Detail } from '../components/{{ entity_name }}Detail';

export function {{ entity_name }}DetailPage() {
  const navigate = useNavigate();
  const { id } = useParams<{ id: string }>();

  if (id === undefined) {
    return null;
  }

  return (
    <section className="mx-auto max-w-2xl p-6">
      <{{ entity_name }}Detail
        id={ {{~ if primary_key.is_number }}Number(id){{ else }}id{{ end ~}} }
        onEdit={() => navigate(`/{{ route_segment }}/${encodeURIComponent(id)}/edit`)}
        onBack={() => navigate('/{{ route_segment }}')}
      />
    </section>
  );
}
