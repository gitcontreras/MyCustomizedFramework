import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
import { toSignal } from '@angular/core/rxjs-interop';
import { ActivatedRoute, Router } from '@angular/router';
import { map } from 'rxjs';
import { {{ entity_name }}FormComponent } from '../components/{{ file_stem }}-form.component';

@Component({
  selector: 'app-{{ file_stem }}-edit-page',
  imports: [{{ entity_name }}FormComponent],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <section class="mx-auto max-w-2xl p-6">
      @if (id(); as id) {
        <app-{{ file_stem }}-form [id]="id" (saved)="back()" (cancelled)="back()" />
      }
    </section>
  `,
})
export class {{ entity_name }}EditPage {
  private readonly router = inject(Router);

  protected readonly id = toSignal(
    inject(ActivatedRoute).paramMap.pipe(
      map((params) => {
        const raw = params.get('id');
        return raw === null ? undefined : {{ if primary_key.is_number }}Number(raw){{ else }}raw{{ end }};
      }),
    ),
    { requireSync: true },
  );

  protected back(): void {
    void this.router.navigate(['/{{ route_segment }}']);
  }
}