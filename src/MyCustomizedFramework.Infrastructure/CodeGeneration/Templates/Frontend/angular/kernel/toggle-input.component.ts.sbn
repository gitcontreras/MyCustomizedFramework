import { ChangeDetectionStrategy, Component, input, model } from '@angular/core';

@Component({
  selector: 'app-toggle-input',
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <button
      type="button"
      role="switch"
      [id]="fieldId()"
      [attr.aria-checked]="value()"
      [disabled]="disabled()"
      [class]="value() ? onClass : offClass"
      (click)="value.set(!value())"
    >
      <span [class]="value() ? 'inline-block h-4 w-4 translate-x-6 transform rounded-full bg-white transition-transform' : 'inline-block h-4 w-4 translate-x-1 transform rounded-full bg-white transition-transform'"></span>
    </button>
  `,
})
export class ToggleInputComponent {
  readonly fieldId = input.required<string>();
  readonly disabled = input(false);
  readonly value = model.required<boolean>();

  protected readonly onClass =
    'relative inline-flex h-6 w-11 items-center rounded-full bg-indigo-600 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 disabled:opacity-50';
  protected readonly offClass =
    'relative inline-flex h-6 w-11 items-center rounded-full bg-gray-300 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 disabled:opacity-50';
}