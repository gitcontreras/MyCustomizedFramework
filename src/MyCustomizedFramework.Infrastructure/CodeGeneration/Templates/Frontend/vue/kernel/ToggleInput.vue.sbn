<script setup lang="ts">
defineProps<{
  id: string;
  disabled?: boolean;
}>();

const model = defineModel<boolean>({ required: true });
</script>

<template>
  <button
    :id="id"
    type="button"
    role="switch"
    :aria-checked="model"
    :disabled="disabled"
    :class="[
      'relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 disabled:opacity-50',
      model ? 'bg-indigo-600' : 'bg-gray-300',
    ]"
    @click="model = !model"
  >
    <span
      :class="[
        'inline-block h-4 w-4 transform rounded-full bg-white transition-transform',
        model ? 'translate-x-6' : 'translate-x-1',
      ]"
    />
  </button>
</template>