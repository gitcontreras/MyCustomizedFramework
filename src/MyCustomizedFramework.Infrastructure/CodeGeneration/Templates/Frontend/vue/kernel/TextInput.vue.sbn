<script setup lang="ts">
import { inputClassName } from './form-classes';

defineProps<{
  id: string;
  invalid?: boolean;
}>();

const model = defineModel<string>({ required: true });
</script>

<template>
  <input
    :id="id"
    v-model="model"
    :aria-invalid="invalid || undefined"
    :aria-describedby="invalid ? `${id}-error` : undefined"
    :class="inputClassName"
  />
</template>