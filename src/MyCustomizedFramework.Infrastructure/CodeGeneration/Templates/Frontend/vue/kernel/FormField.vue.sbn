<script setup lang="ts">
defineProps<{
  id: string;
  label: string;
  required?: boolean;
  error?: string;
}>();
</script>

<template>
  <div class="space-y-1">
    <label :for="id" class="block text-sm font-medium text-gray-700">
      <span v-text="label" />
      <span v-if="required" class="ml-0.5 text-red-600">*</span>
    </label>
    <slot />
    <p v-if="error" :id="`${id}-error`" role="alert" class="text-sm text-red-600" v-text="error" />
  </div>
</template>