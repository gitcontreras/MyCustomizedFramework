<script setup lang="ts">
import { computed } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import {{ entity_name }}Detail from '../components/{{ entity_name }}Detail.vue';

const router = useRouter();
const route = useRoute();
const id = computed(() => {
  const raw = String(route.params.id);
  return {{ if primary_key.is_number }}Number(raw){{ else }}raw{{ end }};
});
</script>

<template>
  <section class="mx-auto max-w-2xl p-6">
    <{{ entity_name }}Detail
      :id="id"
      @edit="router.push(`/{{ route_segment }}/${encodeURIComponent(String(id))}/edit`)"
      @back="router.push('/{{ route_segment }}')"
    />
  </section>
</template>